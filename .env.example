# SensorLab – Firebase Environment Configuration Example
# Copy this file to .env and fill in your Firebase project values.
# If these variables are left empty, SensorLab runs smoothly in "Interactive Local / Offline Demo Mode"
# with complete mock persistence, allowing full demonstration and testing without blocking.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase AI Logic / Gemini Model integration
# Note: For production Firebase AI Logic, the SDK calls backend vertex/firebase endpoints.
# You can also supply a Gemini API key for direct Google Generative AI in development if desired.
VITE_GEMINI_API_KEY=

# Optional emulator flags
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_FIRESTORE_EMULATOR_HOST=localhost:8080
