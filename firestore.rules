rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.role == 'admin');
    }

    function isTeacher() {
      return isAuthenticated() && 
        (request.auth.token.teacher == true || 
         request.auth.token.role == 'teacher' || 
         isAdmin());
    }

    // Public / Student read-only educational content
    match /learningModules/{moduleId} {
      allow read: if isAuthenticated() && (resource.data.published == true || isTeacher());
      allow write: if isTeacher();
    }

    match /lessons/{lessonId} {
      allow read: if isAuthenticated() && (resource.data.published == true || isTeacher());
      allow write: if isTeacher();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated() && (resource.data.published == true || isTeacher());
      allow write: if isTeacher();
    }

    match /quizzes/{quizId} {
      allow read: if isAuthenticated() && (resource.data.published == true || isTeacher());
      allow write: if isTeacher();
    }

    // Teacher Profiles
    match /teacherProfiles/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(teacherId) || isAdmin();
    }

    // Master Certificates Collection
    match /certificates/{certificateId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    // Student User Profiles
    match /users/{userId} {
      // Students can read their own profile, Teachers and Admins can read student profiles
      allow read: if isOwner(userId) || isTeacher();
      
      // Creation: must be own UID, cannot grant admin role
      allow create: if isOwner(userId) && 
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string;

      // Update: student can update basic profile info, cannot change admin flag
      allow update: if (isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role']))) ||
        isAdmin();

      allow delete: if isAdmin();

      // Subcollections under users/{userId}
      match /lessonProgress/{lessonId} {
        allow read: if isOwner(userId) || isTeacher();
        allow write: if isOwner(userId);
      }

      match /projectProgress/{projectId} {
        allow read: if isOwner(userId) || isTeacher();
        allow write: if isOwner(userId);
      }

      match /savedCircuits/{circuitId} {
        allow read: if isOwner(userId) || isTeacher();
        allow write, delete: if isOwner(userId);
      }

      match /quizAttempts/{attemptId} {
        allow read: if isOwner(userId) || isTeacher();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }

      match /achievements/{achievementId} {
        allow read: if isOwner(userId) || isTeacher();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }

      match /certificates/{certificateId} {
        allow read: if isOwner(userId) || isTeacher();
        allow create, update: if isTeacher();
        allow delete: if isAdmin();
      }
    }
  }
}
